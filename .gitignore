# Rust build artifacts (any workspace, any depth)
target/
**/*.rs.bk
Cargo.lock.bak

# Never commit secrets, local vault blobs, or the relay's database.
*.vault
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env
.env.*
deploy/sona.env

# Tauri / node build output
clients/desktop/src-tauri/gen/
# Generated by build.sh from the operator's .env.update (apt self-enrollment paths).
clients/desktop/src-tauri/tauri.linux.conf.json
node_modules/
dist/

# Fuzzing artifacts (corpora grow unbounded; crashes get committed deliberately if kept)
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/
