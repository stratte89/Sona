{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sona",
  "version": "0.1.54",
  "identifier": "app.sona.messenger",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sona",
        "width": 1080,
        "height": 720,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' https: wss: http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}